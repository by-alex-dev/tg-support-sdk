{
  "openapi": "3.1.0",
  "info": {
    "title": "tg-support protocol",
    "version": "1.0.0",
    "description": "Asynchronous host/service protocol. Request HMAC covers TGS1-REQ\\n<timestamp>\\nPOST\\n<path+query>\\n<raw body>; claim/heartbeat response HMAC covers TGS1-RES\\n<timestamp>\\n<status>\\n<path+query>\\n<raw body>. Signature is v1=<lowercase hex HMAC-SHA256>; K is decoded third part of tgs1.<bot_uuid>.<base64url_key>. Verify before parsing, within ±300 seconds. Unknown object fields are ignored. See docs/design/protocol.md for AEAD subjects, atomic batches, operation ordering and result correlation."
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": {
          "default": "http://127.0.0.1:3000",
          "description": "Absolute service base URL, including any deployment path prefix."
        }
      }
    }
  ],
  "paths": {
    "/v1/events": {
      "post": {
        "security": [
          {
            "TgSupportSignature": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tg-Support-Bot",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Tg-Support-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)$"
            }
          }
        ],
        "operationId": "acceptEvents",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/definitions/EventBatch"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Batch durably accepted, including duplicates."
          },
          "400": {
            "description": "Malformed/unknown event or result mismatch. Entire batch rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "401": {
            "description": "Signature, timestamp or bot invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "403": {
            "description": "Blocked account/inactive bot; accepted_types can be resent separately.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "409": {
            "description": "Bot/config binding conflict or bot not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "426": {
            "description": "Implementation version below its configured minimum.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "429": {
            "description": "Open operation limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "500": {
            "description": "Transient service error; resend same event ids."
          }
        }
      }
    },
    "/v1/commands/claim": {
      "post": {
        "security": [
          {
            "TgSupportSignature": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tg-Support-Bot",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Tg-Support-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)$"
            }
          }
        ],
        "operationId": "claimCommands",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/definitions/ClaimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Claimed commands. Empty for no work or frozen account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/ClaimResponse"
                }
              }
            },
            "headers": {
              "X-Tg-Support-Timestamp": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              },
              "X-Tg-Support-Signature": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "403": {
            "description": "Blocked account or inactive bot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "500": {
            "description": "Transient service error."
          }
        }
      }
    },
    "/v1/heartbeat": {
      "post": {
        "security": [
          {
            "TgSupportSignature": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tg-Support-Bot",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Tg-Support-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)$"
            }
          }
        ],
        "operationId": "extendAttempt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/definitions/HeartbeatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extended by at most deadline, bounded by one hour from transfer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/HeartbeatResponse"
                }
              }
            },
            "headers": {
              "X-Tg-Support-Timestamp": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              },
              "X-Tg-Support-Signature": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "410": {
            "description": "Attempt no longer active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "500": {
            "description": "Transient service error."
          }
        }
      }
    }
  },
  "webhooks": {
    "hostPush": {
      "post": {
        "security": [
          {
            "TgSupportSignature": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tg-Support-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)$"
            }
          }
        ],
        "operationId": "receivePush",
        "description": "POST to configured host_url. Verify against its configured path/query. A challenge response HMAC covers TGS1-CHALLENGE\\n<host_url exactly as configured>\\n<nonce>. No commands reach a new URL before successful challenge. HTTPS only; prohibit service/private address ranges on each connection and redirects.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/definitions/HostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified challenge response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/ChallengeResponse"
                }
              }
            }
          },
          "202": {
            "description": "Commands accepted before asynchronous execution."
          },
          "400": {
            "description": "Malformed host request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "401": {
            "description": "Signature/timestamp failed; execute nothing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/definitions/RejectResponse"
                }
              }
            }
          },
          "503": {
            "description": "Host not initialized."
          }
        }
      }
    }
  },
