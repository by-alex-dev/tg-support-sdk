        },
        "user": {
          "$ref": "#/definitions/Token"
        }
      },
      "required": [
        "type",
        "event_id",
        "user"
      ],
      "additionalProperties": true,
      "title": "UserForgetEvent"
    },
    "CreatedMessage": {
