{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tg-support.dev/protocol/v1/schema.json",
  "title": "ProtocolV1",
  "description": "Wire contracts from docs/design/protocol.md. Unknown fields are accepted and consumers use only documented fields. Command envelope validation precedes method authorization; method recipes and AEAD address checks are separate.",
  "definitions": {
    "Token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "title": "Token"
    },
    "SealedBlob": {
      "type": "string",
      "pattern": "^s1\\.[A-Za-z0-9_-]{4}\\.[A-Za-z0-9_-]{16}\\.[A-Za-z0-9_-]{22,}$",
      "maxLength": 65536,
      "title": "SealedBlob"
    },
    "EventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "EventId"
    },
    "OpId": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$",
      "title": "OpId"
    },
    "AttemptToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "title": "AttemptToken"
    },
    "DeadlineSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 600,
      "title": "DeadlineSeconds"
    },
    "TokenPurpose": {
      "type": "string",
      "enum": [
        "user",
        "group",
        "message",
        "thread",
        "profile"
      ],
      "title": "TokenPurpose"
    },
    "BlobPurpose": {
      "type": "string",
      "enum": [
        "private_chat",
        "group_chat",
        "message_id",
        "thread_id",
        "language",
        "edit_content",
        "reactions",
        "notice_text",
        "binding"
      ],
      "title": "BlobPurpose"
    },
    "TemplateId": {
      "type": "string",
      "enum": [
        "topic_title",
        "topic_header",
        "new_user_notice",
        "notifications_topic_title",
        "welcome_hint",
        "user_edited",
        "edited_by_support",
        "replaced_by_support"
      ],
      "title": "TemplateId"
    },
    "Method": {
      "type": "string",
      "enum": [
        "createForumTopic",
        "editForumTopic",
        "unpinAllForumTopicMessages",
        "sendMessage",
        "copyMessage",
        "editMessageText",
        "editMessageCaption",
        "deleteMessage",
        "setMessageReaction",
        "pinChatMessage"
      ],
      "title": "Method"
    },
    "SealedRef": {
      "type": "object",
      "properties": {
        "sealed": {
          "$ref": "#/definitions/SealedBlob"
        }
      },
      "required": [
        "sealed"
      ],
      "additionalProperties": true,
      "title": "SealedRef"
    },
    "TemplateRef": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string"
        },
        "language": {
          "$ref": "#/definitions/SealedRef"
        },
        "user": {
          "$ref": "#/definitions/SealedRef"
        }
      },
      "required": [
        "template",
        "language"
      ],
      "additionalProperties": true,
      "title": "TemplateRef"
    },
    "ParamValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "$ref": "#/definitions/SealedRef"
        },
        {
          "$ref": "#/definitions/TemplateRef"
        }
      ],
      "title": "ParamValue"
    },
    "Revision": {
      "type": "object",
      "properties": {
        "edit_date": {
          "type": "integer",
          "minimum": 0
        },
        "update_id": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "edit_date",
        "update_id"
      ],
      "additionalProperties": true,
      "title": "Revision"
    },
    "BotConfiguredEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bot_configured"
        },
        "event_id": {
          "$ref": "#/definitions/EventId"
        },
        "telegram_bot_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "group": {
          "$ref": "#/definitions/Token"
        },
        "group_chat": {
          "$ref": "#/definitions/SealedBlob"
        },
        "features": {
          "type": "object",
          "properties": {
            "notifications_topic": {
              "type": "boolean"
            },
            "welcome_hint": {
              "type": "boolean"
            }
          },
          "required": [
            "notifications_topic",
            "welcome_hint"
          ],
          "additionalProperties": true
        },
        "transport": {
          "type": "string",
          "enum": [
            "push",
            "pull"
          ]
        },
        "host_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_seconds": {
          "$ref": "#/definitions/DeadlineSeconds"
        },
        "sdk_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^/]+/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "config_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "event_id",
        "telegram_bot_id",
        "group",
        "group_chat",
        "features",
        "transport",
        "host_url",
        "deadline_seconds",
        "sdk_version",
        "config_revision"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "pull"
              }
            }
          },
          "then": {
            "properties": {
              "host_url": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "push"
              }
            }
          },
          "then": {
            "properties": {
              "host_url": {
                "type": "string"
              }
            }
          }
        }
      ],
      "title": "BotConfiguredEvent"
    },
    "UserMessageEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "user_message"
        },
        "event_id": {
          "$ref": "#/definitions/EventId"
        },
        "user": {
          "$ref": "#/definitions/Token"
        },
        "chat": {
          "$ref": "#/definitions/SealedBlob"
        },
        "profile": {
          "$ref": "#/definitions/Token"
        },
        "language": {
          "$ref": "#/definitions/SealedBlob"
        },
        "message": {
          "$ref": "#/definitions/Token"
        },
        "message_id": {
          "$ref": "#/definitions/SealedBlob"
        },
        "reply_to": {
          "anyOf": [
            {
              "$ref": "#/definitions/Token"
            },
            {
              "type": "null"
            }
          ]
        },
        "copyable": {
          "type": "boolean"
        },
        "is_bot_command": {
          "type": "boolean"
        },
        "is_start": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "event_id",
        "user",
        "chat",
        "profile",
        "language",
        "message",
        "message_id",
        "reply_to",
        "copyable",
        "is_bot_command",
        "is_start"
      ],
      "additionalProperties": true,
      "if": {
        "properties": {
          "is_start": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "is_bot_command": {
            "const": true
          }
        }
      },
      "title": "UserMessageEvent"
    },
    "UserInteractionEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "user_interaction"
        },
        "event_id": {
          "$ref": "#/definitions/EventId"
        },
        "user": {
          "$ref": "#/definitions/Token"
        },
        "chat": {
          "$ref": "#/definitions/SealedBlob"
        },
        "profile": {
          "$ref": "#/definitions/Token"
        },
        "language": {
          "$ref": "#/definitions/SealedBlob"
        }
      },
      "required": [
        "type",
        "event_id",
        "user",
        "chat",
        "profile",
        "language"
      ],
      "additionalProperties": true,
      "title": "UserInteractionEvent"
    },
    "UserEditEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "user_edit"
        },
        "event_id": {
          "$ref": "#/definitions/EventId"
        },
        "user": {
          "$ref": "#/definitions/Token"
        },
        "message": {
          "$ref": "#/definitions/Token"
        },
        "revision": {
          "$ref": "#/definitions/Revision"
        },
        "field": {
          "type": "string",
          "enum": [
            "text",
            "caption"
          ]
        },
        "content": {
          "$ref": "#/definitions/SealedBlob"
        }
      },
      "required": [
        "type",
        "event_id",
        "user",
        "message",
        "revision",
        "field",
        "content"
      ],
      "additionalProperties": true,
      "title": "UserEditEvent"
    },
    "UserReactionEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "user_reaction"
        },
        "event_id": {
          "$ref": "#/definitions/EventId"
        },
        "user": {
          "$ref": "#/definitions/Token"
        },
        "message": {
          "$ref": "#/definitions/Token"
        },
        "reactions": {
          "$ref": "#/definitions/SealedBlob"
        }
      },
      "required": [
        "type",
        "event_id",
        "user",
        "message",
        "reactions"
      ],
      "additionalProperties": true,
      "title": "UserReactionEvent"
    },
    "SupportMessageEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "support_message"
        },
        "event_id": {
          "$ref": "#/definitions/EventId"
        },
        "group": {
          "$ref": "#/definitions/Token"
        },
        "thread": {
          "$ref": "#/definitions/Token"
        },
        "message": {
          "$ref": "#/definitions/Token"
        },
        "message_id": {
          "$ref": "#/definitions/SealedBlob"
        },
        "reply_to": {
          "anyOf": [
            {
              "$ref": "#/definitions/Token"
            },
            {
              "type": "null"
            }
          ]
        },
        "reply_scoped_message_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/SealedBlob"
            },
            {
              "type": "null"
            }
          ]
        },
        "copyable": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "event_id",
        "group",
        "thread",
        "message",
        "message_id",
        "reply_to",
        "reply_scoped_message_id",
        "copyable"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "reply_to": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "reply_scoped_message_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reply_to": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "reply_scoped_message_id": {
                "$ref": "#/definitions/SealedBlob"
              }
            }
          }
        }
      ],
      "title": "SupportMessageEvent"
    },
    "SupportEditEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "support_edit"
        },
        "event_id": {
          "$ref": "#/definitions/EventId"
        },
        "group": {
          "$ref": "#/definitions/Token"
        },
        "thread": {
          "$ref": "#/definitions/Token"
        },
        "message": {
          "$ref": "#/definitions/Token"
        },
        "revision": {
          "$ref": "#/definitions/Revision"
        },
        "field": {
          "type": "string",
          "enum": [
            "text",
            "caption"
          ]
        },
        "content": {
          "$ref": "#/definitions/SealedBlob"
        }
      },
      "required": [
        "type",
        "event_id",
        "group",
        "thread",
        "message",
        "revision",
        "field",
        "content"
      ],
      "additionalProperties": true,
      "title": "SupportEditEvent"
    },
    "SupportReactionEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "support_reaction"
        },
        "event_id": {
          "$ref": "#/definitions/EventId"
        },
        "group": {
          "$ref": "#/definitions/Token"
        },
        "thread": {
          "$ref": "#/definitions/Token"
        },
        "message": {
          "$ref": "#/definitions/Token"
        },
        "reactions": {
          "$ref": "#/definitions/SealedBlob"
        }
      },
      "required": [
        "type",
        "event_id",
        "group",
        "thread",
        "message",
        "reactions"
