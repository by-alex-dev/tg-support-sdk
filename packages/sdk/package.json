  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md", "CHANGELOG.md", "THIRD_PARTY_NOTICES"],
  "exports": {".": {"types": "./dist/index.d.ts", "default": "./dist/index.js"}, "./grammy": {"types": "./dist/grammy.d.ts", "default": "./dist/grammy.js"}},
  "bin": {"tg-support-sdk": "./dist/cli.js"},
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "grammy": "1.46.0",
    "tg-support-protocol": "0.1.0",
